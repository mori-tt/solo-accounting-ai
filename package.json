{
  "name": "solo-accounting-ai",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-solo-accounting-ai 'vitest run --config vitest.rules.config.mts'",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage --project demo-solo-accounting-ai 'playwright test'",
    "test:emulators": "firebase emulators:exec --only firestore --project demo-solo-accounting-ai 'pnpm vitest run tests/emulator'",
    "emulators": "firebase emulators:start"
  },
  "dependencies": {
    "client-only": "^0.0.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.3",
    "openai": "7.45.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  }
}
