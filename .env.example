# Firebase クライアント設定(ブラウザ公開可。NEXT_PUBLIC_ プレフィックス必須)
# 開発時は demo-* プロジェクトIDでEmulatorのみに接続する。本番値を置かないこと。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "true" で Firebase Emulator Suite に接続する(開発のデフォルト)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Emulator のホスト:ポート(省略時は localhost の標準ポート)
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# サーバーサイド(firebase-admin)用 Emulator 接続先
# Admin SDK はこれらが設定されていれば認証情報なしでEmulatorに接続する
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# AI機能(サーバーサイド専用。NEXT_PUBLIC_ を付けないこと)
# 提案プロバイダ: heuristic(既定)|openai
AI_LLM_PROVIDER=
# 領収書OCR: none(既定)|openai。openai利用にはOPENAI_API_KEYが必要
AI_OCR_PROVIDER=
OPENAI_API_KEY=
# 提案用モデル(省略時 gpt-5-mini)
OPENAI_MODEL=
# OCR用モデル(省略時 OPENAI_MODEL)
OPENAI_OCR_MODEL=
