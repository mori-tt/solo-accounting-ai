rules_version = '2';

// docs/SECURITY_RULES.md に基づく認可ルール。
// - すべての事業データは businesses/{businessId} 配下にスコープする
// - members/{uid} の role(owner/editor/viewer)で認可する
// - 締め済み期間(closed)に属するデータはクライアントから変更不可。
//   status='locked'のドキュメント保護に加え、日付から fy{year} を導出して
//   closed期間への作成・更新・削除も rules 層で拒否する(R2-3)
// - aiSuggestion フィールドはAdmin SDKのみ書き込み可(クライアント禁止)
// - auditLogs はappend-only
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共通関数 ----------

    function signedIn() {
      return request.auth != null;
    }

    function businessDoc(businessId) {
      return /databases/$(database)/documents/businesses/$(businessId);
    }

    function memberDoc(businessId, uid) {
      return /databases/$(database)/documents/businesses/$(businessId)/members/$(uid);
    }

    function fiscalPeriodDoc(businessId, periodId) {
      return /databases/$(database)/documents/businesses/$(businessId)/fiscalPeriods/$(periodId);
    }

    function txDoc(businessId, txId) {
      return /databases/$(database)/documents/businesses/$(businessId)/transactions/$(txId);
    }

    function invoiceDoc(businessId, invoiceId) {
      return /databases/$(database)/documents/businesses/$(businessId)/invoices/$(invoiceId);
    }

    function receiptDoc(businessId, receiptId) {
      return /databases/$(database)/documents/businesses/$(businessId)/receipts/$(receiptId);
    }

    // memberドキュメントの存在を確認してからロールを取得する
    function isMember(businessId) {
      return signedIn() && exists(memberDoc(businessId, request.auth.uid));
    }

    function role(businessId) {
      return get(memberDoc(businessId, request.auth.uid)).data.get('role', '');
    }

    function hasRole(businessId, roles) {
      return isMember(businessId) && role(businessId) in roles;
    }

    function isOwner(businessId) {
      return hasRole(businessId, ['owner']);
    }

    function canEdit(businessId) {
      return hasRole(businessId, ['owner', 'editor']);
    }

    // businessドキュメントの ownerUid(真のオーナー)
    function ownerUid(businessId) {
      return get(businessDoc(businessId)).data.get('ownerUid', '');
    }

    // update時に指定フィールドが変更されていないことを確認する
    function unaffected(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // クライアントはaiSuggestionを書き込めない(Admin SDKはrulesをバイパス)
    function noAiSuggestion() {
      return !('aiSuggestion' in request.resource.data);
    }

    // YYYY-MM-DD 形式の日付文字列
    function dateString(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // 紐付くTransactionが締め済み(locked)かどうか
    function txLocked(businessId, txId) {
      return exists(txDoc(businessId, txId))
        && get(txDoc(businessId, txId)).data.get('status', '') == 'locked';
    }

    // 日付(YYYY-MM-DD)が属する会計年度の fiscalPeriod が closed か。
    // periodId は fy{会計年度開始年}。fiscalYearStartMonth 未満の月は
    // 前年度に属する。期間ドキュメントが存在しなければ closed ではない
    // (期間は締め処理が必ず作成するため、未作成期間への混入は起きない)
    function inClosedPeriod(businessId, dateStr) {
      let startMonth =
        get(businessDoc(businessId)).data.get('fiscalYearStartMonth', 1);
      let y = int(dateStr.split('-')[0]);
      let m = int(dateStr.split('-')[1]);
      let fy = m >= startMonth ? y : y - 1;
      return exists(fiscalPeriodDoc(businessId, 'fy' + string(fy)))
        && get(fiscalPeriodDoc(businessId, 'fy' + string(fy)))
          .data.get('status', '') == 'closed';
    }

    // 指定した fiscalPeriod が closed か(closingChecks の対象期間検証用)
    function periodClosed(businessId, periodId) {
      return exists(fiscalPeriodDoc(businessId, periodId))
        && get(fiscalPeriodDoc(businessId, periodId))
          .data.get('status', '') == 'closed';
    }

    // リンク先transactionIdが実在し締め済みでないこと(create/update用)。
    // transactionId未設定は許可、存在しないtxへのリンクは拒否する
    function linkedTxExistsUnlocked(businessId, d) {
      return !('transactionId' in d)
        || (d.transactionId is string
          && exists(txDoc(businessId, d.transactionId))
          && !txLocked(businessId, d.transactionId));
    }

    // リンク先transactionIdが締め済みでないこと(delete用。
    // tx不存在=既に消えた参照は許可しなければdocが削除不能になる)
    function linkedTxNotLocked(businessId, d) {
      return !('transactionId' in d)
        || !txLocked(businessId, d.transactionId);
    }

    // ---------- users ----------
    // 本人のみ読み書き可(email等の個人情報を含むため他者には公開しない)
    match /users/{uid} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---------- businesses ----------
    match /businesses/{businessId} {
      allow get, list: if isMember(businessId);
      allow create: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.ownerUid == request.auth.uid;
      // ownerUidのクライアントからの移転は禁止
      allow update: if isOwner(businessId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      // 事業の削除はサブコレクション残骸を防ぐためサーバーサイドのみ
      allow delete: if false;

      // ---------- members ----------
      match /members/{uid} {
        allow get, list: if isMember(businessId);
        allow create: if signedIn()
          && request.resource.data.role in ['owner', 'editor', 'viewer']
          // uidフィールドをdoc IDと一致させる(不一致は幽霊member・
          // listMyBusinessIdsのcollectionGroup(uid==)とisMemberの解釈分岐を招く)
          && request.resource.data.uid == uid
          // 帰属の偽装を防ぐ
          && request.resource.data.invitedBy == request.auth.uid
          && (
            // business作成と同一バッチで、作成者が自分をownerとして登録するブートストラップ。
            // getAfter()でバッチ適用後のbusinessドキュメントを検証する
            (request.auth.uid == uid
              && request.resource.data.role == 'owner'
              && getAfter(businessDoc(businessId)).data.ownerUid == request.auth.uid)
            // 既存ownerが他メンバーを招待・追加する場合
            || isOwner(businessId)
          );
        // 権限昇格防止のためmember管理はownerのみ。
        // business.ownerUid のmemberはownerロール維持を強制する
        // (自分・別オーナーによる降格で不可逆ロックアウトになるため)
        allow update: if isOwner(businessId)
          && request.resource.data.role in ['owner', 'editor', 'viewer']
          && request.resource.data.get('uid', uid) == uid
          && unaffected(['invitedBy'])
          && !(uid == ownerUid(businessId)
            && request.resource.data.role != 'owner');
        allow delete: if isOwner(businessId)
          && uid != ownerUid(businessId);
      }

      // ---------- transactions ----------
      match /transactions/{transactionId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && validTransaction(request.resource.data)
          && noAiSuggestion()
          && request.resource.data.createdBy == request.auth.uid
          && !inClosedPeriod(businessId, request.resource.data.date);
        // 締め済み(locked)は変更不可。status='locked'への変更はAdmin SDKのみ。
        // closed期間内のdateへの変更・closed期間内docの変更も不可
        allow update: if canEdit(businessId)
          && resource.data.status != 'locked'
          && validTransaction(request.resource.data)
          && unaffected(['aiSuggestion', 'createdBy', 'createdAt'])
          && !inClosedPeriod(businessId, request.resource.data.date)
          && !inClosedPeriod(businessId, resource.data.date);
        // editorはdraftのみ削除可、ownerはlocked以外を削除可
        allow delete: if resource.data.status != 'locked'
          && !inClosedPeriod(businessId, resource.data.date)
          && (isOwner(businessId)
            || (hasRole(businessId, ['editor']) && resource.data.status == 'draft'));
      }

      function validTransaction(d) {
        return d.type in ['income', 'expense', 'transfer']
          && dateString(d.date)
          && d.amount is int
          && d.status in ['draft', 'confirmed'];
      }

      // ---------- expenses ----------
      match /expenses/{expenseId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && validExpense(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && linkedTxExistsUnlocked(businessId, request.resource.data)
          && linkedReceiptExists(businessId, request.resource.data);
        // status未設定のドキュメント(サーバー作成)は比較が評価エラーとなり
        // denyとなる(fail-closed)。リンク先txがlockedなら変更・削除不可
        allow update: if canEdit(businessId)
          && resource.data.status != 'locked'
          && validExpense(request.resource.data)
          && unaffected(['transactionId', 'receiptId', 'createdBy', 'createdAt'])
          && linkedTxNotLocked(businessId, resource.data);
        // editorの削除は仕様外のためownerのみ(SECURITY_RULES.md)
        allow delete: if isOwner(businessId)
          && resource.data.status != 'locked'
          && linkedTxNotLocked(businessId, resource.data);
      }

      function validExpense(d) {
        return (!('transactionId' in d) || d.transactionId is string)
          && (!('receiptId' in d) || d.receiptId is string)
          // statusはドメインが持たないため省略可。設定する場合はenum検証
          && (!('status' in d) || d.status in ['draft', 'confirmed'])
          && d.taxCategory is string
          && d.taxAmount is int;
      }

      // expenseのreceiptId参照先が実在すること(設定されている場合)
      function linkedReceiptExists(businessId, d) {
        return !('receiptId' in d)
          || (d.receiptId is string
            && exists(receiptDoc(businessId, d.receiptId)));
      }

      // ---------- withholdingRecords ----------
      // 源泉徴収記録。ドキュメントID=取引IDで支出取引と1:1に紐付く
      // (記録の存在自体が源泉徴収の対象フラグ)。自身は日付を持たないため
      // 締め済み期間・locked保護はリンク先取引から導出する
      match /withholdingRecords/{recordId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && validWithholdingRecord(request.resource.data)
          // transactionIdをdoc IDと一致させる(参照のなりすまし・
          // 別取引への記録付け替えを防ぐ)
          && request.resource.data.transactionId == recordId
          && request.resource.data.createdBy == request.auth.uid
          && withholdingTxOpen(businessId, recordId);
        allow update: if canEdit(businessId)
          && validWithholdingRecord(request.resource.data)
          && unaffected(['transactionId', 'createdBy', 'createdAt'])
          && withholdingTxOpen(businessId, recordId);
        // 取引削除と同一バッチで消される。リンク先がlocked・締め済み期間
        // なら拒否。取引が既に無い孤児レコードは整理できるよう許可する
        allow delete: if canEdit(businessId)
          && (!exists(txDoc(businessId, recordId))
            || withholdingTxOpen(businessId, recordId));
      }

      function validWithholdingRecord(d) {
        return d.transactionId is string
          && d.category in ['service_fee', 'salary']
          && d.paymentAmount is int
          && d.paymentAmount > 0
          && d.taxAmount is int
          && d.taxAmount >= 0
          && d.calculation in ['auto', 'manual']
          && (!('note' in d) || d.note is string);
      }

      // リンク先取引(recordId=transactionId)が実在し、expense型で、
      // lockedでも締め済み期間でもないこと
      function withholdingTxOpen(businessId, recordId) {
        return exists(txDoc(businessId, recordId))
          && get(txDoc(businessId, recordId)).data.get('type', '') == 'expense'
          && !txLocked(businessId, recordId)
          && !inClosedPeriod(businessId,
              get(txDoc(businessId, recordId)).data.get('date', ''));
      }

      // ---------- receipts ----------
      match /receipts/{receiptId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && validReceipt(request.resource.data, receiptId)
          && noAiSuggestion()
          && request.resource.data.createdBy == request.auth.uid
          && linkedTxExistsUnlocked(businessId, request.resource.data);
        // storagePath/fileName/mimeTypeは登録後不変
        // (ダウンロードAPIがdoc値でバケット参照・Content-Type決定するため)
        allow update: if canEdit(businessId)
          && validReceipt(request.resource.data, receiptId)
          && unaffected(['aiSuggestion', 'storagePath', 'fileName',
                         'mimeType', 'createdBy', 'createdAt'])
          && linkedTxExistsUnlocked(businessId, request.resource.data)
          && linkedTxNotLocked(businessId, resource.data);
        allow delete: if (isOwner(businessId)
            || (hasRole(businessId, ['editor']) && resource.data.status == 'unprocessed'))
          && linkedTxNotLocked(businessId, resource.data);
      }

      function validReceipt(d, rid) {
        return d.storagePath is string
          // storagePathは自事業・自証憑配下のみ(ダウンロードAPI/OCRの
          // 任意オブジェクト参照・他証憑への差し替えを防ぐ)
          && d.storagePath.matches(
            'receipts/' + businessId + '/' + rid + '/.+')
          && d.fileName is string
          && d.mimeType in ['image/jpeg', 'image/png', 'image/webp',
                            'image/heic', 'image/heif', 'application/pdf']
          && d.status in ['unprocessed', 'linked', 'archived'];
      }

      // ---------- customers ----------
      match /customers/{customerId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && request.resource.data.name is string;
        allow update: if canEdit(businessId)
          && request.resource.data.name is string
          && unaffected(['createdAt']);
        // editorの削除は仕様外のためownerのみ
        allow delete: if isOwner(businessId);
      }

      // ---------- projects ----------
      match /projects/{projectId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && validProject(request.resource.data);
        allow update: if canEdit(businessId)
          && validProject(request.resource.data)
          && unaffected(['customerId', 'createdAt']);
        allow delete: if isOwner(businessId);
      }

      function validProject(d) {
        return d.customerId is string
          && d.name is string
          && d.status in ['active', 'done', 'archived'];
      }

      // ---------- invoices ----------
      match /invoices/{invoiceId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && validInvoice(request.resource.data)
          && !inClosedPeriod(businessId, request.resource.data.issueDate);
        // 発行済み(issued以降)の請求内容・statusはクライアントから変更不可。
        // 消込/overdue化はサーバー側の処理(支払登録・期限超過検出)で行う
        allow update: if canEdit(businessId)
          && validInvoice(request.resource.data)
          && unaffected(['createdAt'])
          && (resource.data.status == 'draft'
            || (request.resource.data.status == resource.data.status
              && unaffected(['customerId', 'projectId', 'items', 'issueDate',
                             'dueDate', 'totalAmount', 'taxAmount'])));
        // 発行済み・入金済み請求書の削除はownerのみ。closed期間の発行日は削除不可
        allow delete: if (isOwner(businessId)
            || (hasRole(businessId, ['editor']) && resource.data.status == 'draft'))
          && !inClosedPeriod(businessId, resource.data.issueDate);
      }

      function validInvoice(d) {
        return d.customerId is string
          && dateString(d.issueDate)
          && dateString(d.dueDate)
          && d.totalAmount is int
          && d.status in ['draft', 'issued', 'paid', 'overdue'];
      }

      // ---------- payments ----------
      match /payments/{paymentId} {
        allow get, list: if isMember(businessId);
        // invoiceIdは消込先の実在請求書のみ(偽造paymentでpaidTotalを
        // 汚染して請求書をpaid化されるのを防ぐ)
        allow create: if canEdit(businessId)
          && validPayment(request.resource.data)
          && exists(invoiceDoc(businessId, request.resource.data.invoiceId))
          && !inClosedPeriod(businessId, request.resource.data.date)
          && (!('transactionId' in request.resource.data)
            || (request.resource.data.transactionId is string
              && exists(txDoc(businessId,
                              request.resource.data.transactionId))));
        // 消込確定後の金額・日付・消込先は不変(監査上の整合性)
        allow update: if canEdit(businessId)
          && validPayment(request.resource.data)
          && unaffected(['invoiceId', 'amount', 'date', 'transactionId',
                         'createdAt']);
        allow delete: if isOwner(businessId)
          && !inClosedPeriod(businessId, resource.data.date);
      }

      function validPayment(d) {
        return d.invoiceId is string
          && dateString(d.date)
          && d.amount is int;
      }

      // ---------- journalEntries ----------
      // status='draft' は仕訳候補、'confirmed' が確定仕訳、'locked' が締め済み。
      // confirmed仕訳はクライアントから変更・削除不可(確定データの改ざん防止)
      match /journalEntries/{journalEntryId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && validJournalEntry(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && !inClosedPeriod(businessId, request.resource.data.date);
        allow update: if canEdit(businessId)
          && resource.data.status == 'draft'
          && validJournalEntry(request.resource.data)
          && unaffected(['aiSuggestionId', 'sourceType', 'sourceId',
                         'createdBy', 'createdAt'])
          && !inClosedPeriod(businessId, request.resource.data.date)
          && !inClosedPeriod(businessId, resource.data.date);
        allow delete: if isOwner(businessId)
          && resource.data.status != 'locked'
          && !inClosedPeriod(businessId, resource.data.date);
      }

      function validJournalEntry(d) {
        return dateString(d.date)
          && d.description is string
          && d.lines is list
          && d.sourceType in ['manual', 'transaction', 'expense', 'invoice']
          && d.status in ['draft', 'confirmed'];
      }

      // ---------- recurringTemplates ----------
      // 定期取引テンプレート。生成された取引は通常のtransactionsに記録される
      match /recurringTemplates/{templateId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && validRecurringTemplate(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canEdit(businessId)
          && validRecurringTemplate(request.resource.data)
          && unaffected(['createdBy', 'createdAt']);
        allow delete: if isOwner(businessId);
      }

      function validRecurringTemplate(d) {
        return d.name is string
          && d.type in ['income', 'expense', 'transfer']
          && d.account is string
          && (!('counterparty' in d) || d.counterparty is string)
          && (!('description' in d) || d.description is string)
          && d.amount is int
          && d.dayOfMonth is int
          && d.dayOfMonth >= 1
          && d.dayOfMonth <= 31
          && d.active is bool
          && (!('lastGeneratedMonth' in d) || d.lastGeneratedMonth is string);
      }

      // ---------- fixedAssets ----------
      // 固定資産台帳。償却費の取引生成はAdmin SDK経由(ルールは台帳データ自体を保護)
      match /fixedAssets/{assetId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && validFixedAsset(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canEdit(businessId)
          && validFixedAsset(request.resource.data)
          && unaffected(['createdBy', 'createdAt']);
        allow delete: if isOwner(businessId);
      }

      function validFixedAsset(d) {
        return d.name is string
          && dateString(d.acquiredDate)
          && d.acquisitionCost is int
          && d.acquisitionCost > 0
          && d.usefulLifeYears is int
          && d.usefulLifeYears >= 1
          && d.method in ['straightLine', 'decliningBalance']
          && d.businessRatio is int
          && d.businessRatio >= 0
          && d.businessRatio <= 100
          && d.status in ['active', 'disposed']
          && (!('disposedDate' in d) || dateString(d.disposedDate))
          && (!('lastBookedFiscalYear' in d) || d.lastBookedFiscalYear is int);
      }

      // ---------- closingChecks ----------
      // 締めチェック項目。対象・種別は生成後に変えられない(改ざん防止)
      match /closingChecks/{checkId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && validClosingCheck(request.resource.data)
          && request.resource.data.status == 'open'
          && request.resource.data.createdBy == request.auth.uid
          && exists(fiscalPeriodDoc(businessId,
              request.resource.data.fiscalPeriodId))
          && !periodClosed(businessId, request.resource.data.fiscalPeriodId);
        allow update: if canEdit(businessId)
          && validClosingCheck(request.resource.data)
          && unaffected(['fiscalPeriodId', 'type', 'targetPath',
                         'createdBy', 'createdAt'])
          // 解決者の帰属は実行者自身のみ(他人名義の解決を防ぐ)
          && (!('resolvedBy' in request.resource.data)
            || request.resource.data.resolvedBy == request.auth.uid)
          && !periodClosed(businessId, resource.data.fiscalPeriodId);
        allow delete: if isOwner(businessId)
          && !periodClosed(businessId, resource.data.fiscalPeriodId);
      }

      function validClosingCheck(d) {
        return d.fiscalPeriodId is string
          && d.type in ['missing_receipt', 'unpaid_expense', 'unpaid_invoice', 'custom']
          && d.message is string
          && d.status in ['open', 'resolved', 'waived'];
      }

      // ---------- aiSuggestions ----------
      // 提案ドキュメントの生成・削除はAdmin SDKのみ。クライアントは未解決
      // (pending/needs_review)提案のstatus解決とdecidedByの記録のみ行える。
      // 提案の内容・対象・信頼度は変更不可(ADR-0005)
      match /aiSuggestions/{suggestionId} {
        allow get, list: if isMember(businessId);
        allow create, delete: if false;
        allow update: if canEdit(businessId)
          && resource.data.status in ['pending', 'needs_review']
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.decidedBy == request.auth.uid
          && unaffected(['kind', 'target', 'payload', 'confidence', 'reason',
                         'issues', 'attempts', 'retriable', 'lastError',
                         'decidedAt', 'createdBy', 'createdAt']);
      }

      // ---------- monthlySummaries ----------
      // Cloud Functions(Admin SDK)が再計算して書き込む。クライアントは読み取りのみ
      match /monthlySummaries/{yyyyMM} {
        allow get, list: if isMember(businessId);
        allow write: if false;
      }

      // ---------- fiscalPeriods ----------
      match /fiscalPeriods/{periodId} {
        allow get, list: if isMember(businessId);
        // 期間の作成・締め(close)はownerのみ。作成時はopen固定
        allow create: if isOwner(businessId)
          && request.resource.data.status == 'open'
          && dateString(request.resource.data.startDate)
          && dateString(request.resource.data.endDate);
        // closedになった期間はクライアントから再オープン・変更不可。
        // fiscalYear・期間は不変。close時のclosedByは実行者自身のみ
        // (open維持の更新ではclosedBy/closedAtを書き換えさせない)
        allow update: if isOwner(businessId)
          && resource.data.status == 'open'
          && request.resource.data.status in ['open', 'closed']
          && unaffected(['startDate', 'endDate', 'fiscalYear'])
          && (request.resource.data.status == 'open'
            ? unaffected(['closedBy', 'closedAt'])
            : request.resource.data.closedBy == request.auth.uid);
        // 監査証跡保持のためクライアントからの削除は不可
        allow delete: if false;
      }

      // ---------- auditLogs ----------
      // append-only。内容スナップショットではなく識別情報のみ記録する。
      // viewerの追記は不可(読み取り専用)、targetPathは自事業配下に限定し、
      // createdAtは現在時刻±1hのみとして日付偽装を防ぐ
      // (serverTimestampはrequest.timeに解決されるが、emulatorでは微小な
      // ずれがありうるため等価比較ではなく範囲で検証する)
      match /auditLogs/{logId} {
        allow get, list: if isMember(businessId);
        allow create: if canEdit(businessId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action in ['create', 'update', 'delete',
                                              'close', 'run_ai',
                                              'approve_ai', 'reject_ai']
          && request.resource.data.targetPath is string
          && request.resource.data.targetPath
            .matches('businesses/' + businessId + '/.+')
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt
            > request.time - duration.value(1, 'h')
          && request.resource.data.createdAt
            < request.time + duration.value(1, 'h');
        allow update, delete: if false;
      }
    }
  }
}
