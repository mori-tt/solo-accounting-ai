rules_version = '2';

// 注意: このファイルは意図的に未完成の骨格。
// docs/SECURITY_RULES.md の方針に基づき、Emulatorテストとともに実装すること。
// 実装が必要な内容(推測で完成させないこと):
//   - receipts/{businessId}/... 配下は対応するmemberロールで認可
//   - viewerは読み取りのみ、editor/ownerはアップロード可
//   - ファイルサイズ・MIMEタイプの制限
service firebase.storage {
  match /b/{bucket}/o {
    // 安全側デフォルト: すべて拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
