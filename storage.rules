rules_version = '2';

// docs/SECURITY_RULES.md に基づくStorage認可ルール。
// - パスは receipts/{businessId}/{receiptId}/{fileName} のみ許可
// - 対応するFirestore memberドキュメントのロールで認可する
// - viewerは読み取りのみ、editor/ownerはアップロード可
// - ファイルサイズ(10MB)とMIMEタイプを制限する
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(businessId) {
      return /databases/(default)/documents/businesses/$(businessId)/members/$(request.auth.uid);
    }

    function isMember(businessId) {
      return signedIn() && firestore.exists(memberDoc(businessId));
    }

    function role(businessId) {
      return firestore.get(memberDoc(businessId)).data.get('role', '');
    }

    function canWrite(businessId) {
      return isMember(businessId) && role(businessId) in ['owner', 'editor'];
    }

    // 証憑として許可する形式と上限(10MB)
    function validFile() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/heic',
          'application/pdf',
        ];
    }

    match /receipts/{businessId}/{receiptId}/{fileName} {
      allow read: if isMember(businessId);
      // deleteではrequest.resourceがnullのためcreate/updateと分離する
      allow create, update: if canWrite(businessId) && validFile();
      allow delete: if canWrite(businessId);
    }
  }
}
