# 開発用デフォルト。demo-* プロジェクト + Emulator 接続のみ。
# 本番 Firebase には接続しない。実プロジェクトの値をここに置かないこと。
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-solo-accounting-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-solo-accounting-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-solo-accounting-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# サーバーサイド(firebase-admin)用 Emulator 接続先。サーバー専用(NEXT_PUBLICなし)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
GOOGLE_CLOUD_PROJECT=demo-solo-accounting-ai
